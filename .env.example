# AgentProbe Environment Configuration Template

# Database path (leave default for local SQLite or specify PostgreSQL connection string)
AGENTPROBE_DB_PATH=data/agentprobe.db

# Live Model Providers (Optional: Mock providers run deterministically offline with $0 cost)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Policy & Evaluation Overrides
MAX_UNSUPERVISED_REFUND_CENTS=100000
HIGH_RISK_SCORE_THRESHOLD=0.70
MAX_AGENT_STEPS=8
LOOP_DETECTION_WINDOW=2

